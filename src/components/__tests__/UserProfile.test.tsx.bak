import React from 'react';
import { render, screen } from '@testing-library/react';
import { UserProfile } from '../UserProfile';
import * as api from '@/services/api';

jest.mock('@/services/api');
jest.mock('@/hooks/useDebounce', () => ({
  useDebounce: (value: any) => value,
}));

const mockUser = {
  id: '1',
  name: 'John Doe',
  email: 'john@example.com',
  phone: '+1234567890',
  role: 'user' as const,
  status: 'active' as const,
  metadata: {
    lastLogin: '2024-01-01T00:00:00Z',
  },
};

describe('UserProfile - Basic Tests', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should render loading state', () => {
    (api.fetchUserData as jest.Mock).mockImplementation(() => new Promise(() => {}));
    render(<UserProfile userId="1" />);
    expect(screen.getByText(/Loading/i)).toBeTruthy();
  });

  it('should render user data after loading', async () => {
    (api.fetchUserData as jest.Mock).mockResolvedValue(mockUser);
    render(<UserProfile userId="1" />);
    await new Promise(resolve => setTimeout(resolve, 100));
    expect(screen.queryByText('John Doe')).toBeTruthy();
  });

  it('should display error message on load failure', async () => {
    (api.fetchUserData as jest.Mock).mockRejectedValue(new Error('Network error'));
    render(<UserProfile userId="1" />);
    await new Promise(resolve => setTimeout(resolve, 100));
    expect(screen.queryByText(/Network error/i)).toBeTruthy();
  });

  it('should render with light theme by default', async () => {
    (api.fetchUserData as jest.Mock).mockResolvedValue(mockUser);
    const { container } = render(<UserProfile userId="1" />);
    await new Promise(resolve => setTimeout(resolve, 100));
    const profile = container.querySelector('.user-profile');
    expect(profile?.className.includes('light')).toBeTruthy();
  });

  it('should render with specified theme', async () => {
    (api.fetchUserData as jest.Mock).mockResolvedValue(mockUser);
    const { container } = render(<UserProfile userId="1" theme="dark" />);
    await new Promise(resolve => setTimeout(resolve, 100));
    const profile = container.querySelector('.user-profile');
    expect(profile?.className.includes('dark')).toBeTruthy();
  });

  it('should reload user data when userId prop changes', async () => {
    (api.fetchUserData as jest.Mock).mockResolvedValue(mockUser);
    const { rerender } = render(<UserProfile userId="1" />);
    await new Promise(resolve => setTimeout(resolve, 100));
    expect(api.fetchUserData).toHaveBeenCalledWith('1');

    rerender(<UserProfile userId="2" />);
    await new Promise(resolve => setTimeout(resolve, 100));
    expect(api.fetchUserData).toHaveBeenCalledWith('2');
  });
});
